#!/sbin/sh

# Дескриптор для вывода текста в консоль TWRP
OUTFD=$2
ZIPFILE=$3  # Путь к самому этому zip-архиву

ui_print() {
  echo -e "ui_print $1\nui_print" > /proc/self/fd/$OUTFD
}

# Настройки
IMAGE_NAME="vboot.img"
TEMP_DIR="/tmp"
EXTRACTED_IMG="$TEMP_DIR/$IMAGE_NAME"

PART_A="/dev/block/by-name/vendor_boot_a"
PART_B="/dev/block/by-name/vendor_boot_b"

ui_print "==========================="
ui_print "  Vendor Boot Flasher v2   "
ui_print "  (Integrated Image)       "
ui_print "==========================="

# 1. Извлечение образа из ZIP
ui_print "Extracting $IMAGE_NAME..."

# unzip -o (overwrite) [путь_к_зипу] [файл_внутри] -d [куда]
unzip -o "$ZIPFILE" "$IMAGE_NAME" -d "$TEMP_DIR"

if [ -f "$EXTRACTED_IMG" ]; then
    ui_print "Extraction successful."
else
    ui_print "ERROR: Failed to extract $IMAGE_NAME from zip!"
    exit 1
fi

# 2. Прошивка в слот A
if [ -e "$PART_A" ]; then
    ui_print "Flashing slot A..."
    # Используем dd для надежности (хотя cat тоже работает)
    dd if="$EXTRACTED_IMG" of="$PART_A" bs=4096
    if [ $? -eq 0 ]; then
        ui_print "Slot A: OK"
    else
        ui_print "Slot A: ERROR"
    fi
else
    ui_print "Slot A partition not found!"
fi

# 3. Прошивка в слот B
if [ -e "$PART_B" ]; then
    ui_print "Flashing slot B..."
    dd if="$EXTRACTED_IMG" of="$PART_B" bs=4096
    if [ $? -eq 0 ]; then
        ui_print "Slot B: OK"
    else
        ui_print "Slot B: ERROR"
    fi
else
    ui_print "Slot B partition not found!"
fi

# 4. Очистка мусора
rm -f "$EXTRACTED_IMG"

ui_print " "
ui_print "Done. Installing complete."
exit 0